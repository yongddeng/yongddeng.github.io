---
layout: null
---

<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
        xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign docs = site.posts | concat: site.programs %}
  {% for doc in docs %}
    <url>
      <loc>{{ site.url }}{{ doc.url }}</loc>
      <lastmod>{{ doc.date | date_to_xmlschema }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.5</priority>
    </url>
  {% endfor %}
  {% for page in site.pages %}
    {% comment %} Only rendered pages: a layout excludes CSS, the sitemap itself
         and the raw Google verification file. {% endcomment %}
    {% unless page.layout == nil or page.layout == empty or page.sitemap.exclude == "yes" %}
    <url>
      <loc>{{ site.url }}{{ page.url | remove: "index.html" }}</loc>
      <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.3</priority>
    </url>
    {% endunless %}
  {% endfor %}
</urlset>
